# 1. Supabase URL & Public Key (Wajib untuk menampilkan project portofolio)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# 2. Supabase Service Role Key (Direkomendasikan agar login admin & aksi CRUD aman dari RLS)
# Ambil di Supabase Dashboard -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 3. Kunci Rahasia Sesi Login Admin (Untuk enkripsi cookie login admin)
ADMIN_SESSION_SECRET=buat-teks-acak-yang-panjang-disini

# 4. Cadangan Password (Opsional jika tabel portofolio_admin di Supabase bermasalah)
ADMIN_PASSWORD=change-this-password
